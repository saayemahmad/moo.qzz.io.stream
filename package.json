{
  "name": "upload-server",
  "version": "1.0.0",
  "description": "FastAPI upload and streaming server with PM2 management",
  "scripts": {
    "start": "python server_manager.py",
    "pm2": "npx pm2 start ecosystem.config.js",
    "pm2:stop": "npx pm2 stop ecosystem.config.js",
    "pm2:restart": "npx pm2 restart ecosystem.config.js",
    "pm2:logs": "npx pm2 logs upload-fastapi-server",
    "pm2:status": "npx pm2 status"
  }
}
